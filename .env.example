# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional model override (default: gemini-3.6-flash)
# gemini-2.5-flash is blocked for new API keys.
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: Public HTTPS URL (OAuth redirects + Meta webhooks).
# Production: https://growth-ai-alpha-puce.vercel.app
# Set this on Vercel → Settings → Environment Variables (Production).
APP_URL="https://growth-ai-alpha-puce.vercel.app"

# Supabase (Auth + Postgres) — browser-safe
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase server (WhatsApp webhooks + send) — NEVER expose to the frontend
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Meta WhatsApp Cloud API
# Dashboard → App → WhatsApp → API Setup / Webhooks
META_APP_SECRET="YOUR_META_APP_SECRET"
META_WEBHOOK_VERIFY_TOKEN="choose-a-long-random-verify-token"
# Set true in production (default when NODE_ENV=production)
# META_REQUIRE_SIGNATURE="true"

# Optional single-number bootstrap (also connect via WhatsApp Inbox → Connect)
WHATSAPP_ACCESS_TOKEN="YOUR_PERMANENT_CLOUD_API_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_DISPLAY_NUMBER="+234XXXXXXXXXX"
# Map inbound env traffic to an existing clients.id row
# WHATSAPP_BOOTSTRAP_CLIENT_ID="client-1"

# --- Vercel deployment ---
# Import this repo in Vercel → Settings → Environment Variables.
# Required at BUILD time (Vite embeds these):
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# Required at RUNTIME (serverless API):
#   GEMINI_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# Optional runtime:
#   GEMINI_MODEL, APP_URL (custom domain), META_*, WHATSAPP_*
# After deploy, add your Vercel URL to Supabase Auth → URL Configuration.

# Social OAuth (real provider apps — required for live connect/sync)
META_CLIENT_ID=""
META_APP_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Email + payments
RESEND_API_KEY=""
EMAIL_FROM="GrowthOS <billing@yourdomain.com>"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: add custom domains on Vercel automatically
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""

# Calendar publishing cron (Vercel Cron GET /api/calendar/due).
# Set the same value on Vercel. Without it, cron is 401 and due posts
# only publish when someone with the workspace open triggers a flush.
CRON_SECRET=""
