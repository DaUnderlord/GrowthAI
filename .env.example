# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted (public HTTPS for Meta webhooks).
# Example local tunnel: https://xxxx.ngrok-free.app
APP_URL="MY_APP_URL"

# Supabase (Auth + Postgres) — browser-safe
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase server (WhatsApp webhooks + send) — NEVER expose to the frontend
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Meta WhatsApp Cloud API
# Dashboard → App → WhatsApp → API Setup / Webhooks
META_APP_SECRET="YOUR_META_APP_SECRET"
META_WEBHOOK_VERIFY_TOKEN="choose-a-long-random-verify-token"
# Set true in production (default when NODE_ENV=production)
# META_REQUIRE_SIGNATURE="true"

# Optional single-number bootstrap (also connect via WhatsApp Inbox → Connect)
WHATSAPP_ACCESS_TOKEN="YOUR_PERMANENT_CLOUD_API_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_DISPLAY_NUMBER="+234XXXXXXXXXX"
# Map inbound env traffic to an existing clients.id row
# WHATSAPP_BOOTSTRAP_CLIENT_ID="client-1"
